    <UserSecretsId>82978516-24aa-4d83-a498-1002a76fa69f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
